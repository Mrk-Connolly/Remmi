@startuml Remmi_AI_Flow
skinparam defaultTextAlignment center
skinparam backgroundColor White
left to right direction

' =============================================
' INPUTS
' =============================================
class IncomingMessage {
  sourceApp
  sender
  content
  timestamp
}

class IncomingEmail {
  senderAddress
  subject
  body
  folder
  timestamp
}

class VoiceRecording {
  audioFile
  duration
  timestamp
}

' =============================================
' FILTERING
' =============================================
class MonitoringFilter {
  watchedApps
  watchedContacts
  watchedEmailFolders
}

MonitoringFilter ..> IncomingMessage : passes filter
MonitoringFilter ..> IncomingEmail : passes filter

' =============================================
' PROCESSING
' =============================================
class AnalyzedContent {
  rawText
  detectedEvent
  detectedTask
  confidenceLevel
  sourceMessageId
}

IncomingMessage ..> AnalyzedContent : analyzed
IncomingEmail ..> AnalyzedContent : analyzed
VoiceRecording ..> AnalyzedContent : transcribed & analyzed

' =============================================
' OUTPUTS
' =============================================
class CalendarEvent {
  title
  startDateTime
  endDateTime
  location
}

class Task {
  title
  dueDateTime
  priority
}

AnalyzedContent ..> CalendarEvent : <<may create>>
AnalyzedContent ..> Task : <<may create>>

note left of MonitoringFilter
  User configures which apps,
  contacts and folders to watch.
  Everything else is ignored.
end note

note right of AnalyzedContent
  The system detects dates, times,
  locations and actions in text.
  Low confidence results are flagged
  for user confirmation.
end note

@enduml
