@startuml Remmi_Relationships
skinparam defaultTextAlignment center
skinparam backgroundColor White
left to right direction

' =============================================
' CORE DOMAIN & RELATIONSHIPS
' =============================================
abstract class CalendarItem {
  id
  title
  description
  creationDate
  lastModifiedDate
  categories
}

class CalendarEvent extends CalendarItem {
  startDateTime
  endDateTime
  location
}

class Task extends CalendarItem {
  dueDateTime
  priority
  isCompleted
  estimatedDuration
}

Task "0..1" --> "0..1" CalendarEvent : linked

' =============================================
' CATEGORIES
' =============================================
class Category {
  name
  color
  icon
}

Category "0..*" --> "0..1" Category : parent
CalendarItem "*" -- "*" Category

' =============================================
' AI PROCESSING CHAIN
' =============================================
class MonitoringFilter {
  watchedApps
  watchedContacts
  watchedEmailFolders
}

class IncomingMessage {
  sourceApp
  sender
  content
}

class AnalyzedContent {
  rawText
  detectedEvent
  detectedTask
  confidenceLevel
}

MonitoringFilter ..> IncomingMessage : filters
IncomingMessage ..> AnalyzedContent : analyzed by
AnalyzedContent ..> CalendarEvent : <<creates>>
AnalyzedContent ..> Task : <<creates>>

' =============================================
' VOICE TRIGGER
' =============================================
class VoiceRecording {
  audioFile
  duration
}

VoiceRecording ..> AnalyzedContent : transcribed to

' =============================================
' SYNC
' =============================================
class ExternalCalendar {
  provider
  events
}

ExternalCalendar ..> CalendarEvent : syncs

' =============================================
' USER
' =============================================
class "User" as User

User --> CalendarEvent : manages
User --> Task : manages
User --> Category : manages
User --> MonitoringFilter : configures
User --> VoiceRecording : initiates

@enduml
