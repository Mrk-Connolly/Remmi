@startuml Remmi_AI_Workflow
skinparam backgroundColor White
skinparam ParticipantPadding 20
skinparam BoxPadding 10

' =============================================
' SEQUENCE: AI Message Analysis Workflow
' =============================================
box "Device" #LightBlue
  actor User
  participant "HomeWidget" as Widget
  participant "MessageMonitor" as Monitor
  participant "VoiceRecorder" as Recorder
  participant "AIService" as AI
  participant "TaskManager" as TaskMgr
  participant "CalendarManager" as CalMgr
end box

box "External" #LightGreen
  participant "RemoteAI\n(LLM API)" as Remote
  participant "GoogleCalendar" as GCal
end box

== Voice Recording Flow ==
User -> Widget : press voice button
Widget -> Recorder : startRecording()
User -> Recorder : speaks command
Recorder -> AI : stopAndAnalyze()
AI -> Remote : transcribeAudio(audioFile)
Remote --> AI : transcription text
AI -> Remote : analyzeText(transcription)
Remote --> AI : AnalysisResult
AI --> Recorder : AnalysisResult

alt confidence > threshold
  Recorder -> TaskMgr : addTask(detectedTask)
  TaskMgr --> Recorder : task created
  Recorder -> CalMgr : addEvent(detectedEvent)
  CalMgr --> Recorder : event created
  TaskMgr --> Recorder : linkToCalendarEvent(taskId, eventId)
else needs confirmation
  Recorder -> User : show confirmation dialog
  User -> Recorder : confirm / edit
end

== Message Analysis Flow ==
participant "Messaging App\n(WhatsApp, SMS)" as MsgApp

MsgApp -> Monitor : onNewMessage(app, sender, content)
group filter check
  Monitor -> Monitor : shouldMonitor(app, sender)?
end
Monitor -> AI : analyzeText(content)
AI -> Remote : analyzeText(content)
Remote --> AI : AnalysisResult
AI --> Monitor : AnalysisResult

alt confidence > threshold
  Monitor -> TaskMgr : addTask(detectedTask)
  Monitor -> CalMgr : addEvent(detectedEvent)
else needs confirmation
  Monitor -> User : notification to review
end

== Google Calendar Sync ==
CalMgr -> GCal : syncWithProvider()
GCal --> CalMgr : remote events
CalMgr -> CalMgr : resolveConflicts(local, remote)
CalMgr -> GCal : push new/modified local events
GCal --> CalMgr : sync complete

@enduml
