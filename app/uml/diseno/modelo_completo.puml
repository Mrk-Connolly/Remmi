@startuml Remmi_Design
skinparam defaultTextAlignment center
skinparam backgroundColor White
left to right direction

' ===== ENUMS (outside packages) =====
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum PopupType {
  LOCK_SCREEN
  NOTIFICATION
  IN_APP
}

' =============================================
' DOMAIN LAYER
' =============================================
package "Domain Layer" {
  abstract class CalendarItem {
    id: String
    title: String
    description: String
    createdAt: long
    lastModified: long
    isArchived: boolean
  }

  class CalendarEvent extends CalendarItem {
    startDateTime: LocalDateTime
    endDateTime: LocalDateTime
    location: String
    googleEventId: String
    repeatGroupId: String
  }

  class Task extends CalendarItem {
    dueDateTime: LocalDateTime
    priority: Priority
    isCompleted: boolean
    estimatedDuration: int
    calendarEventId: String
  }

  class Category {
    id: String
    name: String
    color: int
    parentCategoryId: String
  }

  Task "0..1" --> "0..1" CalendarEvent : linked
  Category "0..*" --> "0..1" Category : parent
}

' =============================================
' PERSISTENCE LAYER
' =============================================
package "Persistence Layer" {
  interface CalendarEventRepository {
    + getById(id): CalendarEvent?
    + getByDateRange(start, end): List<CalendarEvent>
    + save(event): CalendarEvent
    + delete(id): boolean
  }

  interface TaskRepository {
    + getById(id): Task?
    + getPending(): List<Task>
    + getByCalendarEventId(calEventId): Task?
    + save(task): Task
    + delete(id): boolean
  }

  interface CategoryRepository {
    + getAll(): List<Category>
    + getById(id): Category?
    + save(category): Category
    + delete(id): boolean
  }

  interface ConfigRepository {
    + getMonitoringConfig(): MonitoringConfig
    + saveMonitoringConfig(config): void
    + getUserPreferences(): UserPreferences
    + saveUserPreferences(prefs): void
  }
}

' =============================================
' BUSINESS LAYER
' =============================================
package "Business Layer" {
  class CalendarManager {
    - eventRepo: CalendarEventRepository
    - syncProvider: CalendarSyncProvider
    + getEvents(start, end): List<CalendarEvent>
    + addEvent(event): CalendarEvent
    + createRecurringEvents(baseEvent, config): List<CalendarEvent>
    + updateEvent(event): CalendarEvent
    + deleteEvent(eventId): boolean
    + deleteRepeatGroup(groupId): boolean
    + syncWithProvider(): SyncResult
  }

  class TaskManager {
    - taskRepo: TaskRepository
    + getTasks(filter): List<Task>
    + addTask(task): Task
    + completeTask(taskId): boolean
    + deleteTask(taskId): boolean
    + linkToCalendarEvent(taskId, eventId): void
  }

  class CategoryManager {
    - categoryRepo: CategoryRepository
    + getAll(): List<Category>
    + getTree(): List<Category>
    + create(name, color, parentId): Category
    + assignToItem(itemId, categoryIds): void
    + getForItem(itemId): List<Category>
  }

  class SyncManager {
    - calendarManager: CalendarManager
    - syncProvider: CalendarSyncProvider
    + syncAll(): SyncResult
    + resolveConflicts(local, remote): CalendarEvent
  }
}

' =============================================
' SERVICE LAYER
' =============================================
package "Service Layer" {
  interface AIService {
    + analyzeText(text): AnalysisResult
    + analyzeEmail(email): AnalysisResult
    + transcribeAudio(audioFile): String
  }

  class AnalysisResult {
    - detectedEvent: ParsedEventData
    - detectedTask: ParsedTaskData
    - confidence: float
    - rawText: String
    - needsConfirmation: boolean
  }

  class ParsedEventData {
    - title: String
    - startDateTime: LocalDateTime
    - endDateTime: LocalDateTime
    - location: String
  }

  class ParsedTaskData {
    - title: String
    - dueDateTime: LocalDateTime
    - priority: Priority
  }

  class RemoteAIAdapter implements AIService {
    - apiKey: String
    - endpoint: String
    + analyzeText(text): AnalysisResult
    + analyzeEmail(email): AnalysisResult
    + transcribeAudio(audioFile): String
  }

  interface MessageMonitorService {
    + start(config): void
    + stop(): void
    + onNewMessage(app, sender, content): void
  }

  interface EmailMonitorService {
    + start(config): void
    + stop(): void
    + onNewEmail(folder, sender, subject, body): void
  }

  interface VoiceRecorderService {
    + startRecording(): boolean
    + stopAndAnalyze(): AnalysisResult?
  }

  class SystemMessageMonitor implements MessageMonitorService {
    - aiService: AIService
    - config: MonitoringConfig
    + onNewMessage(app, sender, content): void
  }

  class SystemEmailMonitor implements EmailMonitorService {
    - aiService: AIService
    - config: MonitoringConfig
    + onNewEmail(folder, sender, subject, body): void
  }

  class SystemVoiceRecorder implements VoiceRecorderService {
    - aiService: AIService
    - isRecording: boolean
    + startRecording(): boolean
    + stopAndAnalyze(): AnalysisResult?
  }
}

' =============================================
' UI LAYER
' =============================================
package "UI Layer" {
  class PopupService {
    - activePopups: List<Popup>
    + showEventPopup(event): void
    + showTaskPopup(task): void
    + showConfirmationDialog(result): void
    + dismissAll(): void
  }

  class Popup {
    - id: String
    - title: String
    - content: String
    - type: PopupType
    + show(): void
    + dismiss(): void
  }

  class HomeWidget {
    + onUpdate(): void
    + onVoiceButtonClicked(): void
  }

  class UserPreferences {
    - enabledPopupTypes: List<PopupType>
    - syncEnabled: boolean
    + load(): void
    + save(): void
  }

  class MonitoringConfig {
    - selectedApps: List<String>
    - selectedContacts: List<String>
    - selectedEmailFolders: List<String>
    + shouldMonitor(app, sender): boolean
  }
}

' =============================================
' EXTERNAL LAYER
' =============================================
package "External Layer" {
  interface CalendarSyncProvider {
    + fetchEvents(start, end): List<CalendarEvent>
    + createEvent(event): boolean
    + updateEvent(event): boolean
    + deleteEvent(eventId): boolean
    + getLastSyncTimestamp(): long
  }

  class GoogleCalendarAdapter implements CalendarSyncProvider {
    - accessToken: String
    - refreshToken: String
    + authenticate(): boolean
    + fetchEvents(start, end): List<CalendarEvent>
    + createEvent(event): boolean
    + updateEvent(event): boolean
    + deleteEvent(eventId): boolean
  }
}

' =============================================
' LAYER DEPENDENCIES
' =============================================
CalendarManager --> CalendarEventRepository
CalendarManager --> CalendarSyncProvider
TaskManager --> TaskRepository
CategoryManager --> CategoryRepository
SyncManager --> CalendarManager
SyncManager --> CalendarSyncProvider

SystemMessageMonitor --> AIService
SystemMessageMonitor --> MonitoringConfig
SystemEmailMonitor --> AIService
SystemEmailMonitor --> MonitoringConfig
SystemVoiceRecorder --> AIService

SystemMessageMonitor ..> CalendarManager : <<creates>>
SystemMessageMonitor ..> TaskManager : <<creates>>
SystemEmailMonitor ..> CalendarManager : <<creates>>
SystemEmailMonitor ..> TaskManager : <<creates>>
SystemVoiceRecorder ..> CalendarManager : <<creates>>
SystemVoiceRecorder ..> TaskManager : <<creates>>

CalendarManager ..> TaskManager : notifies
TaskManager ..> CalendarManager : notifies

PopupService --> CalendarManager : reads
PopupService --> TaskManager : reads
UserPreferences --> MonitoringConfig
UserPreferences --> PopupService

HomeWidget --> SystemVoiceRecorder : triggers
GoogleCalendarAdapter ..|> CalendarSyncProvider
RemoteAIAdapter ..|> AIService

@enduml
