@startuml Remmi_Design_Relationships
skinparam defaultTextAlignment center
skinparam backgroundColor White
left to right direction

' =============================================
' LAYER OVERVIEW
' =============================================
package "UI Layer" {
  class HomeWidget
  class PopupService
  class UserPreferences
  class MonitoringConfig

  UserPreferences --> MonitoringConfig
}

package "Business Layer" {
  class CalendarManager
  class TaskManager
  class CategoryManager
  class SyncManager
}

package "Service Layer" {
  class AIService <<interface>>
  class MessageMonitorService <<interface>>
  class EmailMonitorService <<interface>>
  class VoiceRecorderService <<interface>>
  class SystemMessageMonitor
  class SystemEmailMonitor
  class SystemVoiceRecorder
  class RemoteAIAdapter
}

package "Persistence Layer" {
  class CalendarEventRepository <<interface>>
  class TaskRepository <<interface>>
  class CategoryRepository <<interface>>
  class ConfigRepository <<interface>>
}

package "External Layer" {
  class CalendarSyncProvider <<interface>>
  class GoogleCalendarAdapter
}

' =============================================
' CROSS-LAYER RELATIONSHIPS
' =============================================
' UI → Business
HomeWidget --> SystemVoiceRecorder : triggers
PopupService --> CalendarManager : reads
PopupService --> TaskManager : reads
UserPreferences --> PopupService : configures

' Business → Persistence
CalendarManager --> CalendarEventRepository
CalendarManager --> CalendarSyncProvider
TaskManager --> TaskRepository
CategoryManager --> CategoryRepository
SyncManager --> CalendarManager
SyncManager --> CalendarSyncProvider

' Services → Business
SystemMessageMonitor ..> CalendarManager : creates
SystemMessageMonitor ..> TaskManager : creates
SystemEmailMonitor ..> CalendarManager : creates
SystemEmailMonitor ..> TaskManager : creates
SystemVoiceRecorder ..> CalendarManager : creates
SystemVoiceRecorder ..> TaskManager : creates

' Services → AI
SystemMessageMonitor --> AIService
SystemEmailMonitor --> AIService
SystemVoiceRecorder --> AIService

' Services → Config
SystemMessageMonitor --> MonitoringConfig
SystemEmailMonitor --> MonitoringConfig

' Adapters → Interfaces
GoogleCalendarAdapter ..|> CalendarSyncProvider
RemoteAIAdapter ..|> AIService
SystemMessageMonitor ..|> MessageMonitorService
SystemEmailMonitor ..|> EmailMonitorService
SystemVoiceRecorder ..|> VoiceRecorderService

' Business ←→ Business
CalendarManager ..> TaskManager : notifies
TaskManager ..> CalendarManager : notifies

note right of CalendarManager
  All managers depend on
  repository interfaces (DIP)
end note

note right of SystemMessageMonitor
  Depends on AI service interface.
  Actual impl can be local or remote.
end note

@enduml
