@startuml Remmi_Herencia
skinparam defaultTextAlignment center
left to right direction

' =============================================
' CALENDAR ITEM HIERARCHY
' =============================================
package "CalendarItem Hierarchy" {
  abstract class CalendarItem {
    # id: String (UUID)
    # title: String
    # description: String
    # createdAt: long
    # lastModified: long
    # isArchived: boolean
  }

  class CalendarEvent extends CalendarItem {
    - startDate: Date
    - endDate: Date
    - allDay: boolean
    - repeatType: EventRepeatType
    - location: String
    - googleEventId: String (nullable)
    - attendees: String (nullable, JSON)
  }

  class Task extends CalendarItem {
    - dueDate: Date (nullable)
    - priority: TaskPriority
    - isCompleted: boolean
    - calendarEventId: String (nullable)
    - estimatedDuration: int (nullable)
  }

  Task --> CalendarEvent : calendarEventId (FK)
}

' =============================================
' CATEGORIES (N:M)
' =============================================
package "Categories" {
  class Category {
    - id: String (UUID)
    - name: String
    - color: int
    - icon: String (nullable)
    - parentCategoryId: String (nullable)
  }

  class ItemCategory {
    - itemId: String
    - categoryId: String
  }

  CalendarItem "1" -- "*" ItemCategory
  Category "1" -- "*" ItemCategory
  Category --> Category : parentCategoryId (self-ref)
}

' =============================================
' POPUP HIERARCHY
' =============================================
package "Popup Hierarchy" {
  abstract class Popup {
    # id: String
    # title: String
    # content: String
    # isEnabled: boolean
    + {abstract} show(): void
    + {abstract} dismiss(): void
  }

  class LockScreenPopup extends Popup {
    - windowType: int
    - gravity: int
    + show(): void
    + dismiss(): void
  }

  class NotificationPopup extends Popup {
    - channelId: String
    - notificationId: int
    + show(): void
    + dismiss(): void
  }

  class InAppDialogPopup extends Popup {
    - dialogStyle: int
    + show(): void
    + dismiss(): void
  }
}

' =============================================
' BOT HIERARCHY (FUTURE)
' =============================================
package "Bot Hierarchy (Future)" {
  abstract class Bot {
    + execute(): void
    + isActive(): boolean
  }

  class PriceSearchBot extends Bot {
    - targetProducts: List<ProductWatch>
    - apiConnectors: List<APIConnector>
    + searchPrices(): void
    + notifyOnPriceDrop(productId, targetPrice): void
  }

  class HealthHabitBot extends Bot {
    - habits: List<Habit>
    + remindHabit(habit): void
    + trackProgress(): void
  }

  class ConversationRecorderBot extends Bot {
    - isRecording: boolean
    + startRecording(session): void
    + stopRecording(): TranscriptResult
  }
}

@enduml
