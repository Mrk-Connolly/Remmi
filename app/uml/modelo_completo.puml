@startuml Remmi_Complete
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
left to right direction

' =============================================
' ENUMS
' =============================================
enum EventRepeatType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SyncStatus {
  SYNCED
  PENDING_LOCAL
  PENDING_REMOTE
  CONFLICT
}

enum FilterSource {
  WHATSAPP
  TELEGRAM
  EMAIL
  SMS
}

' =============================================
' CORE
' =============================================
abstract class CalendarItem {
  # id: String (UUID)
  # title: String
  # description: String
  # createdAt: long
  # lastModified: long
  # isArchived: boolean
}

class CalendarEvent extends CalendarItem {
  - startDate: Date
  - endDate: Date
  - allDay: boolean
  - repeatType: EventRepeatType
  - location: String
  - googleEventId: String (nullable)
  - attendees: String (nullable, JSON)
}

class Task extends CalendarItem {
  - dueDate: Date (nullable)
  - priority: TaskPriority
  - isCompleted: boolean
  - calendarEventId: String (nullable)
  - estimatedDuration: int (nullable)
}

class Category {
  - id: String (UUID)
  - name: String
  - color: int
  - icon: String (nullable)
  - parentCategoryId: String (nullable)
}

class ItemCategory {
  - itemId: String
  - categoryId: String
}

' =============================================
' INTERFACES
' =============================================
interface CalendarEventRepository {
  + getById(id): CalendarEvent?
  + getByDateRange(start, end): List<CalendarEvent>
  + save(event): CalendarEvent
  + delete(id): boolean
}

interface TaskRepository {
  + getById(id): Task?
  + getPending(): List<Task>
  + getByCalendarEventId(calEventId): Task?
  + save(task): Task
  + delete(id): boolean
  + markCompleted(id, completed): boolean
}

interface CategoryRepository {
  + getAll(): List<Category>
  + getById(id): Category?
  + getByParent(parentId): List<Category>
  + save(category): Category
  + delete(id): boolean
}

interface CalendarSyncProvider {
  + fetchEvents(start, end): List<CalendarEvent>
  + createEvent(event): boolean
  + updateEvent(event): boolean
  + deleteEvent(eventId): boolean
  + getLastSyncTimestamp(): long
}

interface AIAnalyzerService {
  + analyzeText(text): AIAnalysisResult
  + analyzeEmail(emailData): AIAnalysisResult
  + transcribeAudio(audioFile): String
}

interface MessageMonitorService {
  + startMonitoring(config): void
  + stopMonitoring(): void
  + onNewMessage(app, sender, content): void
}

interface EmailMonitorService {
  + startMonitoring(config): void
  + stopMonitoring(): void
  + onNewEmail(folder, sender, subject, body): void
}

interface VoiceRecorderService {
  + startRecording(): boolean
  + stopAndAnalyze(): AIAnalysisResult?
  + isRecording(): boolean
}

interface PopupPresenter {
  + show(title, content, type): void
  + dismiss(id): void
  + dismissAll(): void
}

' =============================================
' AI
' =============================================
class MonitoringConfig {
  - monitoredApps: List<AppFilter>
  - monitoredEmailFolders: List<String>
  - monitoredContacts: List<ContactFilter>
  + shouldMonitor(app, sender): boolean
}

class AppFilter {
  - appName: String
  - isActive: boolean
}

class ContactFilter {
  - contactId: String
  - contactName: String
  - source: FilterSource
}

class AIAnalysisResult {
  - detectedEvent: ParsedEventData? (nullable)
  - detectedTask: ParsedTaskData? (nullable)
  - confidence: float
  - rawText: String
  - sourceMessageId: String
}

class ParsedEventData {
  - title: String
  - description: String
  - startDate: Date
  - endDate: Date
  - location: String
}

class ParsedTaskData {
  - title: String
  - description: String
  - dueDate: Date
  - priority: TaskPriority
}

class AIAnalyzer {
  - service: AIAnalyzerService
  + analyzeText(text): AIAnalysisResult
  + analyzeEmail(emailData): AIAnalysisResult
  + analyzeVoice(audioFile): AIAnalysisResult
}

class MessageMonitorAdapter implements MessageMonitorService {
  - config: MonitoringConfig
  + startMonitoring(config): void
  + stopMonitoring(): void
  + onNewMessage(app, sender, content): void
}

class EmailMonitorAdapter implements EmailMonitorService {
  - config: MonitoringConfig
  + startMonitoring(config): void
  + stopMonitoring(): void
  + onNewEmail(folder, sender, subject, body): void
}

class VoiceRecorderAdapter implements VoiceRecorderService {
  - isRecording: boolean
  + startRecording(): boolean
  + stopAndAnalyze(): AIAnalysisResult?
  + isRecording(): boolean
}

' =============================================
' MANAGERS
' =============================================
class CalendarManager {
  - eventRepo: CalendarEventRepository
  - syncProvider: CalendarSyncProvider
  + getEvents(start, end): List<CalendarEvent>
  + addEvent(event): CalendarEvent
  + updateEvent(event): CalendarEvent
  + deleteEvent(eventId): boolean
  + syncWithProvider(): SyncResult
}

class TaskManager {
  - taskRepo: TaskRepository
  + getTasks(filter): List<Task>
  + addTask(task): Task
  + updateTask(task): Task
  + completeTask(taskId): boolean
  + deleteTask(taskId): boolean
  + getTaskByCalendarEvent(calEventId): Task?
}

class CategoryManager {
  - categoryRepo: CategoryRepository
  + getAll(): List<Category>
  + getTree(): List<Category>
  + create(name, color, icon, parentId): Category
  + update(category): Category
  + delete(id): boolean
  + assignToItem(itemId, categoryIds): void
  + getCategoriesForItem(itemId): List<Category>
}

' =============================================
' POPUPS
' =============================================
abstract class Popup {
  # id: String
  # title: String
  # content: String
  # isEnabled: boolean
  + {abstract} show(): void
  + {abstract} dismiss(): void
}

class LockScreenPopup extends Popup {
  - windowType: int
  - gravity: int
  + show(): void
  + dismiss(): void
}

class NotificationPopup extends Popup {
  - channelId: String
  - notificationId: int
  + show(): void
  + dismiss(): void
}

class InAppDialogPopup extends Popup {
  - dialogStyle: int
  + show(): void
  + dismiss(): void
}

class PopupManagerService {
  - presenter: PopupPresenter
  - activePopups: List<Popup>
  + showEventPopup(event): void
  + showTaskPopup(task): void
  + showAlertPopup(message): void
  + dismissAll(): void
  + configureFromPreferences(prefs): void
}

' =============================================
' UI / WIDGET / CONFIG
' =============================================
class HomeWidgetProvider {
  + onUpdate(): void
  + onVoiceButtonPressed(): void
}

class UserPreferences {
  - popupConfig: List<Class<Popup>>
  - monitoringConfig: MonitoringConfig
  - syncEnabled: boolean
  + load(): void
  + save(): void
}

' =============================================
' SYNC ADAPTERS
' =============================================
class GoogleCalendarSyncAdapter implements CalendarSyncProvider {
  - accessToken: String
  - refreshToken: String
  - lastSyncTimestamp: long
  + authenticate(): boolean
  + fetchEvents(start, end): List<CalendarEvent>
  + createEvent(event): boolean
  + updateEvent(event): boolean
  + deleteEvent(eventId): boolean
  + getLastSyncTimestamp(): long
}

class RemoteAIAnalyzerService implements AIAnalyzerService {
  + analyzeText(text): AIAnalysisResult
  + analyzeEmail(emailData): AIAnalysisResult
  + transcribeAudio(audioFile): String
}

' =============================================
' FUTURE BOTS
' =============================================
abstract class Bot {
  + execute(): void
  + isActive(): boolean
}

class PriceSearchBot extends Bot {
  - targetProducts: List<ProductWatch>
  - apiConnectors: List<APIConnector>
  + searchPrices(): void
  + notifyOnPriceDrop(productId, targetPrice): void
}

class HealthHabitBot extends Bot {
  - habits: List<Habit>
  + remindHabit(habit): void
  + trackProgress(): void
}

class ConversationRecorderBot extends Bot {
  - isRecording: boolean
  + startRecording(session): void
  + stopRecording(): TranscriptResult
}

' =============================================
' RELATIONSHIPS
' =============================================
CalendarEvent --|> CalendarItem
Task --|> CalendarItem

Task --> CalendarEvent : calendarEventId (nullable FK)

CalendarItem "1" -- "*" ItemCategory
Category "1" -- "*" ItemCategory
Category --> Category : parentCategoryId (self-ref)

CalendarManager --> CalendarEventRepository
CalendarManager --> CalendarSyncProvider
TaskManager --> TaskRepository
CategoryManager --> CategoryRepository

AIAnalyzer --> AIAnalyzerService
MessageMonitorAdapter ..|> MessageMonitorService
EmailMonitorAdapter ..|> EmailMonitorService
VoiceRecorderAdapter ..|> VoiceRecorderService

MessageMonitorAdapter --> MonitoringConfig
EmailMonitorAdapter --> MonitoringConfig

AIAnalyzer ..> CalendarManager : <<creates>>
AIAnalyzer ..> TaskManager : <<creates>>
AIAnalyzer ..> CategoryManager : <<assigns>>

PopupManagerService --> PopupPresenter
LockScreenPopup --|> Popup
NotificationPopup --|> Popup
InAppDialogPopup --|> Popup

HomeWidgetProvider --> VoiceRecorderAdapter : triggers

UserPreferences --> MonitoringConfig
UserPreferences --> PopupManagerService
UserPreferences --> CategoryManager

GoogleCalendarSyncAdapter ..|> CalendarSyncProvider
RemoteAIAnalyzerService ..|> AIAnalyzerService

@enduml
