-- ============================================================
-- REMMI DATABASE BOOTSTRAP
-- Calendar + Tasks + Alarms
-- Development Version
-- ============================================================


-- ============================================================
-- 1. REMOVE EXISTING TABLES
-- ============================================================

DROP TABLE IF EXISTS alarms CASCADE;
DROP TABLE IF EXISTS tasks CASCADE;
DROP TABLE IF EXISTS calendar CASCADE;
DROP TABLE IF EXISTS gift_ideas CASCADE;
DROP TABLE IF EXISTS contacts CASCADE;
DROP TABLE IF EXISTS users CASCADE;


-- ============================================================
-- 2. CALENDAR
-- ============================================================

CREATE TABLE calendar (

    id              TEXT PRIMARY KEY,

    created         TIMESTAMPTZ NOT NULL,
    modified        TIMESTAMPTZ NOT NULL,

    title           TEXT NOT NULL,
    description     TEXT,

    starting_date   DATE NOT NULL,
    starting_time   TIME,

    ending_date     DATE,
    ending_time     TIME,

    priority        TEXT NOT NULL
        CHECK (priority IN ('LOW', 'NORMAL', 'HIGH')),

    participants    TEXT[] NOT NULL DEFAULT '{}',
    repeat          TEXT[] NOT NULL DEFAULT '{}',
    location        TEXT[] NOT NULL DEFAULT '{}',

    linked_tasks    TEXT[] NOT NULL DEFAULT '{}',
    linked_alarm    TEXT

);


-- ============================================================
-- 3. TASKS
-- ============================================================

CREATE TABLE tasks (

    id              TEXT PRIMARY KEY,

    created         TIMESTAMPTZ NOT NULL,
    modified        TIMESTAMPTZ NOT NULL,

    title           TEXT NOT NULL,
    description     TEXT,

    completed       BOOLEAN NOT NULL DEFAULT FALSE,

    due_date        TIMESTAMPTZ,

    priority        TEXT NOT NULL
        CHECK (priority IN ('LOW', 'NORMAL', 'HIGH')),

    parent_task     TEXT,

    linked_calendar TEXT,

    reminders       TEXT[] NOT NULL DEFAULT '{}',
    relationships   TEXT[] NOT NULL DEFAULT '{}'

);


-- ============================================================
-- 4. ALARMS
-- ============================================================

CREATE TABLE alarms (

    id                    TEXT PRIMARY KEY,

    title                 TEXT NOT NULL,

    description           TEXT,

    priority              TEXT NOT NULL
        CHECK (priority IN ('LOW', 'NORMAL', 'HIGH')),

    linked_calendar_event TEXT,

    linked_task           TEXT,

    time                  TIMESTAMPTZ NOT NULL,

    repeatable            TEXT[] NOT NULL DEFAULT '{}',

    custom                TEXT[] NOT NULL DEFAULT '{}'

);


-- ============================================================
-- 5. CONTACTS
-- ============================================================

CREATE TABLE contacts (

    id              TEXT PRIMARY KEY,

    created         TIMESTAMPTZ NOT NULL,
    modified        TIMESTAMPTZ NOT NULL,

    name            TEXT NOT NULL,
    surname         TEXT NOT NULL,
    nickname        TEXT,

    mobile_phone    TEXT,
    email           TEXT,
    birthday        TEXT,

    "group"         TEXT NOT NULL,

    is_favorite     BOOLEAN NOT NULL DEFAULT FALSE,
    in_gift_list    BOOLEAN NOT NULL DEFAULT FALSE

);


-- ============================================================
-- 6. GIFT IDEAS
-- ============================================================

CREATE TABLE gift_ideas (

    id              TEXT PRIMARY KEY,

    created         TIMESTAMPTZ NOT NULL,
    modified        TIMESTAMPTZ NOT NULL,

    contact_id      TEXT NOT NULL REFERENCES contacts(id) ON DELETE CASCADE,

    name            TEXT NOT NULL,
    description     TEXT,
    link            TEXT,
    price           DOUBLE PRECISION,
    event           TEXT
        CHECK (event IN ('Christmas', 'Birthday', 'FathersDay', 'ValentinesDay', 'MothersDay', 'Anniversary', 'Other'))

);


-- ============================================================
-- 5. PERMISSIONS
-- ============================================================

GRANT SELECT, INSERT, UPDATE, DELETE
ON TABLE calendar
TO anon;

GRANT SELECT, INSERT, UPDATE, DELETE
ON TABLE tasks
TO anon;

GRANT SELECT, INSERT, UPDATE, DELETE
ON TABLE alarms
TO anon;

GRANT SELECT, INSERT, UPDATE, DELETE
ON TABLE contacts
TO anon;

GRANT SELECT, INSERT, UPDATE, DELETE
ON TABLE gift_ideas
TO anon;


-- ============================================================
-- 6. ENABLE ROW LEVEL SECURITY
-- ============================================================

ALTER TABLE calendar ENABLE ROW LEVEL SECURITY;
ALTER TABLE tasks ENABLE ROW LEVEL SECURITY;
ALTER TABLE alarms ENABLE ROW LEVEL SECURITY;
ALTER TABLE contacts ENABLE ROW LEVEL SECURITY;
ALTER TABLE gift_ideas ENABLE ROW LEVEL SECURITY;


