-- ============================================================
-- REMMI TEST DATABASE
-- Creates:
--   - test_calendar
--   - test_tasks
-- Includes sample data.
-- ============================================================

---------------------------------------------------------------
-- Remove old test tables
---------------------------------------------------------------

DROP TABLE IF EXISTS test_calendar CASCADE;
DROP TABLE IF EXISTS test_tasks CASCADE;

---------------------------------------------------------------
-- TEST CALENDAR
---------------------------------------------------------------

CREATE TABLE test_calendar (

    id              TEXT PRIMARY KEY,

    created         TIMESTAMPTZ NOT NULL,
    modified        TIMESTAMPTZ NOT NULL,

    title           TEXT NOT NULL,
    description     TEXT,

    starting_time   TIMESTAMPTZ,
    ending_time     TIMESTAMPTZ,

    priority        TEXT NOT NULL,

    participants    JSONB,
    repeat          JSONB,
    reminders       JSONB,
    location        JSONB,

    linked_tasks    JSONB,
    linked_alarm    TEXT,

    relationships   JSONB

);

---------------------------------------------------------------
-- TEST TASKS
---------------------------------------------------------------

CREATE TABLE test_tasks (

    id              TEXT PRIMARY KEY,

    created         TIMESTAMPTZ NOT NULL,
    modified        TIMESTAMPTZ NOT NULL,

    title           TEXT NOT NULL,
    description     TEXT,

    completed       BOOLEAN NOT NULL DEFAULT FALSE,

    due_date        TIMESTAMPTZ,

    priority        TEXT NOT NULL,

    parent_task     TEXT,

    linked_calendar TEXT,

    reminders       JSONB,

    relationships   JSONB

);

---------------------------------------------------------------
-- Permissions
---------------------------------------------------------------

GRANT SELECT, INSERT, UPDATE, DELETE
ON TABLE test_calendar
TO anon;

GRANT SELECT, INSERT, UPDATE, DELETE
ON TABLE test_tasks
TO anon;

---------------------------------------------------------------
-- Enable RLS
---------------------------------------------------------------

ALTER TABLE test_calendar ENABLE ROW LEVEL SECURITY;
ALTER TABLE test_tasks ENABLE ROW LEVEL SECURITY;

---------------------------------------------------------------
-- Calendar Policies
---------------------------------------------------------------

CREATE POLICY "test_calendar_select"
ON test_calendar
FOR SELECT
TO anon
USING (true);

CREATE POLICY "test_calendar_insert"
ON test_calendar
FOR INSERT
TO anon
WITH CHECK (true);

CREATE POLICY "test_calendar_update"
ON test_calendar
FOR UPDATE
TO anon
USING (true)
WITH CHECK (true);

CREATE POLICY "test_calendar_delete"
ON test_calendar
FOR DELETE
TO anon
USING (true);

---------------------------------------------------------------
-- Task Policies
---------------------------------------------------------------

CREATE POLICY "test_tasks_select"
ON test_tasks
FOR SELECT
TO anon
USING (true);

CREATE POLICY "test_tasks_insert"
ON test_tasks
FOR INSERT
TO anon
WITH CHECK (true);

CREATE POLICY "test_tasks_update"
ON test_tasks
FOR UPDATE
TO anon
USING (true)
WITH CHECK (true);

CREATE POLICY "test_tasks_delete"
ON test_tasks
FOR DELETE
TO anon
USING (true);

